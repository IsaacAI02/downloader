# Create a bot with @BotFather, then paste the token here.
TELEGRAM_BOT_TOKEN=123456:replace-me

# Telegram's public Bot API currently documents 50 MB upload limits for video
# and document sends. Keep this below 50 unless you use a local Bot API server.
MAX_UPLOAD_MB=49

# One download at a time is kinder to small servers and avoids rate-limit pain.
MAX_CONCURRENT_DOWNLOADS=1
DOWNLOAD_TIMEOUT_SECONDS=600
NETWORK_TIMEOUT_SECONDS=30
DOWNLOAD_DIR=downloads

# Optional: limit usage to specific Telegram user IDs, comma-separated.
# BOT_OWNER_IDS=123456789,987654321
BOT_OWNER_IDS=

# Optional: domain controls. Values match the exact domain and subdomains.
# ALLOWED_DOMAINS=youtube.com,youtu.be,vimeo.com,tiktok.com,instagram.com
ALLOWED_DOMAINS=
BLOCKED_DOMAINS=
ALLOW_PRIVATE_URLS=false

# Optional yt-dlp settings.
YTDLP_COOKIES_FILE=
YTDLP_USER_AGENT=
YTDLP_FORMAT=
YTDLP_AUDIO_FORMAT=
AUDIO_BITRATE_KBPS=128
VOICE_BITRATE_KBPS=48
FFMPEG_LOCATION=

# Webhook mode is used on free web hosts such as Render.
# Leave WEBHOOK_URL empty for local polling mode.
WEBHOOK_URL=
WEBHOOK_PATH=telegram-webhook
WEBHOOK_SECRET_TOKEN=
PORT=10000

# Optional: if you run Telegram's local Bot API server.
TELEGRAM_API_BASE_URL=
TELEGRAM_API_BASE_FILE_URL=
